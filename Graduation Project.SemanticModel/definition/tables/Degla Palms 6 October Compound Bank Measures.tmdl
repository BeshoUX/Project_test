table 'Degla Palms 6 October Compound Bank Measures'
	lineageTag: b2735e6d-56de-4015-903e-f170f10a63b6

	measure 'Bank Issued Invoices Degla Palms 6 October Compound' = COALESCE(CALCULATE(COUNT('Facts Table'[Installment Name]), 'Facts Table'[Installment status ] IN {"تم السداد", "مستحقة"}, Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: 0
		lineageTag: 99161863-09db-4936-a6c0-d30b8e9be067

	measure 'Bank Collected Invoices Degla Palms 6 October Compound' = COALESCE(CALCULATE(COUNT('Facts Table'[Installment Name]), 'Facts Table'[Installment status ] = "تم السداد", Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: 0
		lineageTag: 3a11a2c8-8451-4a34-aa03-33324e6df710

	measure 'Bank Collected Amount Degla Palms 6 October Compound' = COALESCE(CALCULATE(SUM('Facts Table'[Installment Amount]), 'Facts Table'[Installment status ] = "تم السداد", Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 53ff08d8-dc0c-45e5-ac4a-a10a399ba00b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Bank Collection Rate Degla Palms 6 October Compound' = DIVIDE([Bank Collected Invoices Degla Palms 6 October Compound], [Bank Issued Invoices Degla Palms 6 October Compound], 0)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: d8709782-0927-4068-8b1a-b13eca0c2a11

	measure 'Bank Outstanding Invoices Degla Palms 6 October Compound' = COALESCE(CALCULATE(COUNT('Facts Table'[Installment Name]), 'Facts Table'[Installment status ] = "مستحقة", Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: 0
		lineageTag: 7918c467-ff81-4b17-afe7-f5419baa2b12

	measure 'Bank Outstanding Amount Degla Palms 6 October Compound' = COALESCE(CALCULATE(SUM('Facts Table'[Installment Amount]), 'Facts Table'[Installment status ] = "مستحقة", Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 39658907-809f-459e-896c-b8b4d640747b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Bank Outstanding % Degla Palms 6 October Compound' = DIVIDE([Bank Outstanding Invoices Degla Palms 6 October Compound], [Bank Issued Invoices Degla Palms 6 October Compound], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 51352e9a-9f61-4d3e-9c06-e3e7b60c7c0a

	measure 'Bank Total Invoice Amount Degla Palms 6 October Compound' = COALESCE(CALCULATE(SUM('Facts Table'[Installment Amount]), Customer_Dim[Project Name] = "Degla Palms 6 October Compound", Customer_Dim[BanK] <> "Cash"), 0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7fe79c80-0424-49ad-bdf0-e59ce237e391

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Completion Rate Degla Palms 6 October Compound bank' = COALESCE(CALCULATE(AVERAGE(Customer_Dim[POC]),Customer_Dim[Project Name] = "Degla Palms 6 October Compound",Customer_Dim[BanK] <> "Cash"),0)
		lineageTag: 638c1fb9-3d7d-4368-bd33-826c73f684b0

	measure 'Records in current segment Bank Degla Palms 6 October Compound' = COALESCE(CALCULATE(COUNT(Customer_Dim[Unit No]),'Morshedy Projects'[Project Name] = "Degla Palms 6 October Compound",Customer_Dim[BanK] <> "Cash"),0)
		lineageTag: 172850ca-487f-4468-88fa-84d6a44723b3

	measure 'Total Adopted Units Bank Degla Palms 6 October Compound' = COALESCE(CALCULATE(SUM('Morshedy Projects'[Adopted Total Units]),'Morshedy Projects'[Project Name] = "Degla Palms 6 October Compound",Customer_Dim[BanK] <> "Cash"),0)
		lineageTag: 04a4d6c7-7f49-47f0-bb1b-055baf06c522

	column Column
