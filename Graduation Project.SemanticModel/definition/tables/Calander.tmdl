table Calander
	lineageTag: 0d49a719-5f3f-4d0f-be73-e989eaaebe97
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 0259f40a-a9d9-47dd-bc07-9502d06e9b51
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	partition Calander = calculated
		mode: import
		source =
				CALENDAR(
				    CALCULATE(MIN('Date_Dim'[Date]), ALL('Date_Dim')),
				    CALCULATE(MAX('Date_Dim'[Date]), ALL('Date_Dim'))
				)

	annotation PBI_Id = 4faae6a543b54c1698b5ab441f373e3e

